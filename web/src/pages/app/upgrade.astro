---
import Base from '../../layouts/Base.astro';

const tiers = [
  {
    name: 'Free', price: '€0', cadence: 'always',
    points: ['Every public-domain book', 'No daily limit', 'Streaks, highlights and friends'],
    cta: 'You have this', highlight: false,
  },
  {
    name: 'Plus', price: '€4.99', cadence: 'per month',
    points: ['Everything in Free', '30 pages a day of newer titles', 'Streak freezes'],
    cta: 'Choose Plus', highlight: true,
  },
  {
    name: 'Pro', price: '€9.99', cadence: 'per month',
    points: ['Everything in Plus', '150 pages a day of newer titles', 'Early access to new titles'],
    cta: 'Choose Pro', highlight: false,
  },
];
---

<Base title="Plans — Potpuri">
  <main>
    <h1>Plans</h1>
    <p class="sub">Public-domain books are free forever. Paid plans add newer titles.</p>

    <div class="tiers">
      {tiers.map((t) => (
        <section class:list={['tier', t.highlight && 'hot']}>
          {t.highlight && <div class="badge">Most picked</div>}
          <h2>{t.name}</h2>
          <div class="price">{t.price}<span>/{t.cadence}</span></div>
          <ul>{t.points.map((p) => <li>{p}</li>)}</ul>
          <button class:list={['cta', t.highlight && 'solid']} disabled={t.name === 'Free'}>{t.cta}</button>
        </section>
      ))}
    </div>

    <p class="note">
      Checkout is not wired up yet. The page meter, limits and paywall are live;
      billing is the next piece.
    </p>
  </main>
</Base>

<style>
  main { padding: 20px 16px 92px; padding-top: calc(20px + env(safe-area-inset-top)); max-width: 620px; margin: 0 auto; }
  h1 { margin: 0 0 6px; font-size: 1.6rem; font-weight: 750; letter-spacing: -0.02em; }
  .sub { color: var(--text-dim); margin: 0 0 24px; font-size: 0.92rem; }
  .tiers { display: flex; flex-direction: column; gap: 13px; }
  .tier { position: relative; padding: 20px; border-radius: var(--radius); border: 1px solid var(--border); background: var(--bg-card); }
  .tier.hot { border-color: var(--orange); background: var(--grad-card); }
  .badge { position: absolute; top: -9px; left: 20px; padding: 3px 11px; border-radius: var(--radius-pill); background: var(--grad-brand); color: #fff; font-size: 0.66rem; font-weight: 650; }
  h2 { margin: 0 0 6px; font-size: 1.05rem; }
  .price { font-size: 1.8rem; font-weight: 740; letter-spacing: -0.02em; }
  .price span { font-size: 0.82rem; font-weight: 400; color: var(--text-faint); }
  ul { list-style: none; padding: 0; margin: 15px 0 18px; display: flex; flex-direction: column; gap: 8px; }
  li { font-size: 0.86rem; color: var(--text-dim); padding-left: 18px; position: relative; }
  li::before { content: '✓'; position: absolute; left: 0; color: var(--orange); font-weight: 700; }
  .cta { width: 100%; padding: 12px; border-radius: var(--radius-pill); border: 1px solid var(--border-bright); background: transparent; color: var(--text); font-size: 0.88rem; font-weight: 600; }
  .cta.solid { background: var(--grad-brand); border: none; color: #fff; }
  .cta:disabled { opacity: 0.45; }
  .note { margin-top: 22px; padding: 12px 14px; border-radius: var(--radius-sm); background: var(--bg-card); border: 1px solid var(--border); font-size: 0.8rem; color: var(--text-faint); line-height: 1.5; }
</style>
