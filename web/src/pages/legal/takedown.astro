---
import Base from '../../layouts/Base.astro';
---

<Base title="Report a work — Potpuri" bare>
  <main>
    <a class="back" href="/">← Potpuri</a>
    <h1>Report a work</h1>
    <p class="lead">
      If you hold rights in a work on Potpuri and believe it should not be here, tell us.
      We review every notice and respond to the address you give.
    </p>

    <form id="f">
      <label>
        <span>Your email</span>
        <input name="email" type="email" required placeholder="you@example.com" />
      </label>

      <label>
        <span>Book link or slug <em>(optional)</em></span>
        <input name="book_slug" placeholder="pride-and-prejudice" />
      </label>

      <label>
        <span>Your claim</span>
        <textarea name="claim" rows="6" required
          placeholder="Which work, what right you hold, and why you believe it is infringing."></textarea>
      </label>

      <button type="submit">Send notice</button>
      <p id="msg" class="msg"></p>
    </form>

    <p class="note">
      Knowingly false claims can carry legal consequences. If a work is removed we tell the
      uploader why, and they may respond.
    </p>
  </main>
</Base>

<script>
  const form = document.getElementById('f') as HTMLFormElement;
  const msg = document.getElementById('msg')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    msg.textContent = 'Sending…';
    msg.className = 'msg';

    const data = Object.fromEntries(new FormData(form) as any);
    // Accept a full URL and reduce it to the slug the API expects.
    if (data.book_slug) data.book_slug = String(data.book_slug).split('/').filter(Boolean).pop();

    try {
      const res = await fetch('/v1/legal/takedown', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const body = await res.json();
      if (!res.ok) throw new Error(body.message ?? 'Could not send that.');
      msg.textContent = body.message;
      msg.className = 'msg ok';
      form.reset();
    } catch (err) {
      msg.textContent = err instanceof Error ? err.message : 'Could not send that.';
      msg.className = 'msg bad';
    }
  });
</script>

<style>
  main { max-width: 600px; margin: 0 auto; padding: 28px 22px 70px; padding-top: calc(28px + env(safe-area-inset-top)); }
  .back { font-size: 0.84rem; color: var(--text-faint); }
  h1 { font-size: 1.7rem; font-weight: 740; letter-spacing: -0.02em; margin: 18px 0 8px; }
  .lead { color: var(--text-dim); font-size: 0.92rem; line-height: 1.6; margin-bottom: 26px; }
  form { display: flex; flex-direction: column; gap: 15px; }
  label { display: flex; flex-direction: column; gap: 6px; }
  label span { font-size: 0.82rem; color: var(--text-dim); }
  label em { color: var(--text-faint); font-style: normal; }
  input, textarea { padding: 12px 14px; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--bg-card); color: var(--text); font-family: inherit; font-size: 0.92rem; resize: vertical; }
  input:focus, textarea:focus { outline: none; border-color: var(--orange); }
  button { padding: 13px; border: none; border-radius: var(--radius-pill); background: var(--grad-brand); color: #fff; font-weight: 640; font-size: 0.92rem; }
  .msg { font-size: 0.85rem; margin: 0; color: var(--text-faint); }
  .msg.ok { color: var(--success); }
  .msg.bad { color: #be123c; }
  .note { margin-top: 26px; padding-top: 20px; border-top: 1px solid var(--border); font-size: 0.8rem; color: var(--text-faint); line-height: 1.55; }
</style>
