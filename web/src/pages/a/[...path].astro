---
import Base from '../../layouts/Base.astro';
// Runtime handles and milestones; public shell loads only verified awards.
export const prerender = true;
export function getStaticPaths() { return [{ params: { path: undefined } }]; }
---
<Base title="A reading achievement — Potpuri" bare>
  <main>
    <article id="award" class="award" aria-live="polite">Loading achievement…</article>
    <a href="/signup">Start reading on Potpuri</a>
  </main>
</Base>
<script>
  const [handle, id] = location.pathname.split('/').filter(Boolean).slice(1);
  const article = document.getElementById('award')!;
  const names: Record<string,string> = { 'first-card':'First card', 'hundred-cards':'100 cards', 'full-book':'A whole book' };
  const images: Record<string,string> = { 'first-card':'/achievements/first-card.svg', 'hundred-cards':'/achievements/hundred-cards.svg', 'full-book':'/achievements/full-book.svg' };
  if (!handle || !id || !names[id]) article.textContent = 'This achievement is not available.';
  else fetch(`/v1/achievements/${encodeURIComponent(handle)}/${encodeURIComponent(id)}`)
    .then(r => r.ok ? r.json() : Promise.reject(r.status))
    .then(({achievement,reader}) => {
      article.replaceChildren();
      const img = document.createElement('img'); img.src = images[id]; img.alt = ''; img.width = img.height = 120;
      const heading = document.createElement('h1'); heading.textContent = names[id];
      const owner = document.createElement('p'); owner.textContent = `${reader.display_name} (@${reader.handle}) earned this reading achievement on Potpuri.`;
      const date = document.createElement('time'); date.dateTime = achievement.unlocked_at; date.textContent = new Date(achievement.unlocked_at).toLocaleDateString();
      article.append(img,heading,owner,date);
    }).catch(() => { article.textContent = 'This achievement is not available.'; });
</script>
<style>
  main { min-height:100dvh; display:grid; align-content:center; justify-items:center; gap:20px; padding:24px; text-align:center; }
  .award { width:min(420px,100%); padding:36px 24px; border:1px solid var(--border); border-radius:20px; background:var(--bg-raised); }
  .award img { border-radius:50%; object-fit:cover; }
  .award h1 { font-size:1.5rem; }
  .award p { line-height:1.5; }
</style>
