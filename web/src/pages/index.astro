---
import Base from '../layouts/Base.astro';
import ResumeReading from '../components/ResumeReading.svelte';
import RotatingTagline from '../components/RotatingTagline.svelte';
import ReadingCompanion from '../components/ReadingCompanion.svelte';
import BookCard from '../components/BookCard.svelte';
import sampleBooks from '../lib/guest-books.json';
---

<Base title="Potpuri — timeless classics, bit by bit" description="Read timeless classics, bit by bit. Free books, shared reading, and Puri by your side." bare>
  <main>
    <section class="hero">
      <h1 class="brand-heading"><img src="/glim.svg" alt="" width="48" height="48" /><span class="brand-text">Potpuri</span></h1>
      <RotatingTagline client:load />

      <div class="cta-row">
        <a class="primary" href="/signup">Start reading</a>
        <span class="or">or</span>
        <a class="secondary" href="/app">Browse the library</a>
      </div>

      <ResumeReading client:load />

      <div class="points">
        <p class="mission">Our mission is to make reading <strong>quality literature</strong> a <strong>daily habit</strong> for everyone.</p>
        <p>You can access every book in our catalogue for <strong>free</strong>.<span class="sunny-anchor" data-sunny-anchor aria-hidden="true"></span></p>
        <p>Achieve <strong>streaks</strong> to strengthen your motivation.<span class="sunny-anchor" data-sunny-anchor aria-hidden="true"></span></p>
        <p><strong>Connect with friends</strong>, see what they’re reading, and share your progress. Books help us create a common understanding of our world, <strong>widen our perspective</strong> and bring people closer.<span class="sunny-anchor" data-sunny-anchor aria-hidden="true"></span></p>
        <p>We believe that generative AI can be used <strong>responsibly</strong> and can add meaningful value if it’s applied in the right place. <strong>Puri, our companion</strong>, can help you understand difficult concepts in a book, or translate passages so you can read in your mother tongue. You can use Puri <strong>without an account</strong> by bringing your own API key (<strong>BYOK</strong>); your provider bills the usage. Without an account, explanations and translations disappear when you leave or reload. Sign in to save your results privately, or choose Plus for included AI.</p>
      </div>
    </section>

    <section class="try-books" id="try-it-now" aria-labelledby="try-title">
      <h2 id="try-title">Try it now</h2>
      <p>Meet Puri in A Christmas Carol: try a prepared explanation and translation, then continue into the full book. No account, API key, or reading limit.<span class="sunny-anchor" data-sunny-anchor aria-hidden="true"></span></p>
      <div class="sample-grid">
        {sampleBooks.slice(0, 1).map(book => (
          <BookCard book={book} href={`/try/?book=${book.slug}`} showHistory={false} client:load />
        ))}
      </div>
    </section>

    <footer>
      <a href="/legal/terms">Terms</a>
      <a href="/legal/privacy">Privacy</a>
      <a href="https://github.com/PAndreew/bookworm">Source · AGPL-3.0</a>
      <a href="/legal/takedown">Report a work</a>
    </footer>
  </main>
  <ReadingCompanion experience="facts" client:load />
</Base>

<style>
  main {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 48px 16px 92px;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }
  .hero { --landing-accent: #0f766e; --landing-accent-hover: #115e59; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; }
  h1 { flex-direction: column; justify-content: center; gap: 12px; margin: 0 0 24px; font-size: 1.6rem; font-weight: 700; letter-spacing: -0.02em; }
  .cta-row { display: flex; align-items: center; justify-content: center; gap: 12px; }
  .or { color: var(--text-faint); font-size: 0.85rem; }
  @media (max-width: 560px) { .cta-row { flex-direction: column; gap: 10px; } }
  .primary, .secondary { padding: 14px 28px; border-radius: var(--radius-pill); font-weight: 600; transition: background 0.2s, border-color 0.2s; }
  .primary { background: var(--landing-accent); color: #fff; }
  .primary:hover { background: var(--landing-accent-hover); }
  .secondary { background: var(--bg); border: 1px solid var(--landing-accent); color: var(--landing-accent); }
  .secondary:hover { background: #f0fdfa; border-color: var(--landing-accent-hover); }
  .points { padding: 0; margin: 44px 0 0; display: flex; flex-direction: column; gap: 22px; max-width: 580px; }
  .points p { margin: 0; font-size: 0.95rem; color: var(--text-dim); line-height: 1.7; }
  .points .mission { font-size: clamp(1.25rem, 3.5vw, 1.6rem); color: var(--text); line-height: 1.5; }
  .sunny-anchor { display: inline-block; width: 36px; height: 32px; vertical-align: middle; }
  .points strong { color: var(--landing-accent); font-weight: 600; }
  .try-books { width: 100%; margin-top: 64px; scroll-margin-top: 24px; }
  .try-books h2 { margin: 0 0 12px; font-size: 1.5rem; }
  .try-books > p { margin: 0 0 24px; color: var(--text-dim); font-size: 0.9rem; line-height: 1.6; }
  .sample-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 20px; text-align: left; container-type: inline-size; }
  .sample-grid :global(.card) { transform: translateX(calc(50cqw - 50%)); }
  footer { display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; padding-top: 40px; font-size: 0.8rem; color: var(--text-faint); }
  footer a:hover { color: var(--accent); }
</style>
