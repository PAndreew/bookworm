---
import Base from '../layouts/Base.astro';
import ResumeReading from '../components/ResumeReading.svelte';
import RotatingTagline from '../components/RotatingTagline.svelte';
---

<Base title="Potpuri — read like a feed" bare>
  <main>
    <section class="hero">
      <h1 class="brand-heading"><img src="/rose.svg" alt="" width="48" height="48" /><span class="brand-text">Potpuri</span></h1>
      <RotatingTagline client:load />

      <div class="cta-row">
        <a class="primary" href="/signup">Start reading</a>
        <span class="or">or</span>
        <a class="secondary" href="/app">Browse the shelf</a>
      </div>

      <ResumeReading client:load />

      <ul class="points">
        <li>Every public-domain book, <strong>free</strong>. No limit, no trial, no card.</li>
        <li>Keep a <strong class="streak-word">streak</strong>. Three pages a day. Your friends can see it.</li>
        <li>Keep the lines worth keeping. <strong class="highlight-word">Highlight</strong>, and share as a quote.</li>
      </ul>
    </section>

    <footer>
      <a href="/legal/terms">Terms</a>
      <a href="/legal/privacy">Privacy</a>
      <a href="/legal/takedown">Report a work</a>
    </footer>
  </main>
</Base>

<style>
  main {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 48px 24px 28px;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }
  .hero { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; }
  h1 { flex-direction: column; justify-content: center; gap: 12px; margin: 0 0 24px; font-size: 1.6rem; font-weight: 700; letter-spacing: -0.02em; }
  .cta-row { display: flex; align-items: center; justify-content: center; gap: 12px; }
  .or { color: var(--text-faint); font-size: 0.85rem; }
  @media (max-width: 560px) { .cta-row { flex-direction: column; gap: 10px; } }
  .primary, .secondary { padding: 14px 28px; border-radius: var(--radius-pill); font-weight: 600; transition: background 0.2s, border-color 0.2s; }
  .primary { background: var(--accent); color: #fff; }
  .primary:hover { background: var(--accent-hover); }
  .secondary { background: var(--bg); border: 1px solid var(--border-bright); color: var(--text); }
  .secondary:hover { background: var(--bg-card); border-color: var(--accent); }
  .points { list-style: none; padding: 0; margin: 44px 0 0; display: flex; flex-direction: column; gap: 18px; max-width: 540px; }
  .points li { font-size: 0.95rem; color: var(--text-dim); line-height: 1.7; }
  .points strong { color: var(--accent); font-weight: 600; }
  .points .streak-word { color: #7e22ce; }
  .points .highlight-word { color: #15803d; }
  footer { display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; padding-top: 40px; font-size: 0.8rem; color: var(--text-faint); }
  footer a:hover { color: var(--accent); }
</style>
