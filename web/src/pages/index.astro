---
import Base from '../layouts/Base.astro';
---

<Base title="Bookworm — read like a feed" bare>
  <main>
    <section class="hero">
      <h1><span class="brand-text">Bookworm</span></h1>
      <p class="tag">Books, one page at a time. Like a feed, except it's literature.</p>

      <div class="cta-row">
        <a class="primary" href="/signup">Start reading</a>
        <a class="secondary" href="/app">Browse the shelf</a>
      </div>

      <ul class="points">
        <li><strong>Every public-domain book, free.</strong> No limit, no trial, no card.</li>
        <li><strong>Keep a streak.</strong> Three pages a day. Your friends can see it.</li>
        <li><strong>Keep the lines worth keeping.</strong> Highlight, and share as a quote.</li>
      </ul>
    </section>

    <footer>
      <a href="/legal/terms">Terms</a>
      <a href="/legal/privacy">Privacy</a>
      <a href="/legal/takedown">Report a work</a>
    </footer>
  </main>
</Base>

<style>
  main {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 32px 24px;
    max-width: 560px;
    margin: 0 auto;
  }
  .hero { flex: 1; display: flex; flex-direction: column; justify-content: center; }
  h1 { margin: 0 0 12px; font-size: clamp(2.6rem, 11vw, 3.6rem); font-weight: 780; letter-spacing: -0.04em; }
  .tag { margin: 0 0 32px; font-size: 1.08rem; color: var(--text-dim); line-height: 1.5; }
  .cta-row { display: flex; gap: 11px; flex-wrap: wrap; }
  .primary { padding: 14px 28px; border-radius: var(--radius-pill); background: var(--grad-brand); color: #fff; font-weight: 650; }
  .secondary { padding: 14px 28px; border-radius: var(--radius-pill); border: 1px solid var(--border-bright); color: var(--text); font-weight: 550; }
  .points { list-style: none; padding: 0; margin: 44px 0 0; display: flex; flex-direction: column; gap: 15px; }
  .points li { font-size: 0.93rem; color: var(--text-dim); line-height: 1.5; padding-left: 15px; border-left: 2px solid; border-image: var(--grad-brand) 1; }
  .points strong { color: var(--text); font-weight: 600; }
  footer { display: flex; gap: 20px; justify-content: center; padding-top: 40px; font-size: 0.78rem; color: var(--text-faint); }
</style>
