---
import Base from '../layouts/Base.astro';
import ResumeReading from '../components/ResumeReading.svelte';
import RotatingTagline from '../components/RotatingTagline.svelte';
import GuestPuri from '../components/GuestPuri.svelte';
import sampleBooks from '../lib/guest-books.json';
---

<Base title="Potpuri — read like a feed" bare>
  <main>
    <section class="hero">
      <h1 class="brand-heading"><img src="/glim.svg" alt="" width="48" height="48" /><span class="brand-text">Potpuri</span></h1>
      <RotatingTagline client:load />

      <div class="cta-row">
        <a class="primary" href="/signup">Start reading</a>
        <span class="or">or</span>
        <a class="secondary" href="/app">Browse the shelf</a>
      </div>

      <ResumeReading client:load />

      <ul class="points">
        <li>Every public-domain book, <strong>free</strong>. No limit, no trial, no card.<span class="sunny-anchor" data-sunny-anchor aria-hidden="true"></span></li>
        <li>Keep a <strong class="streak-word">streak</strong>. Three text cards a day. Your friends can see it.<span class="sunny-anchor" data-sunny-anchor aria-hidden="true"></span></li>
        <li>Keep the lines worth keeping. <strong class="highlight-word">Highlight</strong>, and share as a quote.<span class="sunny-anchor" data-sunny-anchor aria-hidden="true"></span></li>
      </ul>
    </section>

    <section class="try-books" id="try-it-now" aria-labelledby="try-title">
      <h2 id="try-title">Try it now</h2>
      <p>Open a book. No account needed. Try the first 10 cards with Puri.</p>
      <div class="sample-grid">
        {sampleBooks.map(book => (
          <a class="sample-book" href={`/try/?book=${book.slug}`} style={`background:${book.color}`}>
            <h3>{book.title}</h3>
            <span class="sample-author">{book.author}</span>
            <span class="sample-read">Read →</span>
          </a>
        ))}
      </div>
    </section>

    <footer>
      <a href="/legal/terms">Terms</a>
      <a href="/legal/privacy">Privacy</a>
      <a href="/legal/takedown">Report a work</a>
    </footer>
  </main>
  <GuestPuri landing client:load />
</Base>

<style>
  main {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 48px 24px 92px;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }
  .hero { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; }
  h1 { flex-direction: column; justify-content: center; gap: 12px; margin: 0 0 24px; font-size: 1.6rem; font-weight: 700; letter-spacing: -0.02em; }
  .cta-row { display: flex; align-items: center; justify-content: center; gap: 12px; }
  .or { color: var(--text-faint); font-size: 0.85rem; }
  @media (max-width: 560px) { .cta-row { flex-direction: column; gap: 10px; } }
  .primary, .secondary { padding: 14px 28px; border-radius: var(--radius-pill); font-weight: 600; transition: background 0.2s, border-color 0.2s; }
  .primary { background: var(--accent); color: #fff; }
  .primary:hover { background: var(--accent-hover); }
  .secondary { background: var(--bg); border: 1px solid var(--border-bright); color: var(--text); }
  .secondary:hover { background: var(--bg-card); border-color: var(--accent); }
  .points { list-style: none; padding: 0; margin: 44px 0 0; display: flex; flex-direction: column; gap: 18px; max-width: 540px; }
  .points li { font-size: 0.95rem; color: var(--text-dim); line-height: 1.7; }
  .sunny-anchor { display: inline-block; width: 36px; height: 32px; vertical-align: middle; }
  .points strong { color: var(--accent); font-weight: 600; }
  .points .streak-word { color: #7e22ce; }
  .points .highlight-word { color: #15803d; }
  .try-books { width: 100%; margin-top: 64px; scroll-margin-top: 24px; }
  .try-books h2 { margin: 0 0 12px; font-size: 1.5rem; }
  .try-books > p { margin: 0 0 24px; color: var(--text-dim); font-size: 0.9rem; line-height: 1.6; }
  .sample-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; text-align: left; }
  .sample-book { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 18px; padding: 24px; transition: border-color 0.2s; }
  .sample-book:hover { border-color: var(--accent); }
  .sample-book h3 { margin: 0 0 12px; font-size: 1.05rem; line-height: 1.4; }
  .sample-author { color: var(--text-dim); font-size: 0.8rem; }
  .sample-read { margin-top: auto; padding-top: 24px; font-size: 0.85rem; font-weight: 600; }
  @media (max-width: 380px) { .sample-grid { grid-template-columns: 1fr; } }
  footer { display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; padding-top: 40px; font-size: 0.8rem; color: var(--text-faint); }
  footer a:hover { color: var(--accent); }
</style>
