---
import Base from '../../layouts/Base.astro';
import Reader from '../../components/Reader.svelte';

// The catalogue is fetched at build time so every book gets a prerendered shell
// with real metadata -- which is what a shared link needs in order to preview.
// Page content itself is always fetched live, so it stays behind the meter.
export async function getStaticPaths() {
  const base = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';

  try {
    const res = await fetch(`${base}/v1/books`);
    if (!res.ok) throw new Error(String(res.status));
    const { books } = await res.json();

    return books.map((b: any) => ({
      params: { slug: b.slug },
      props: { title: b.title, author: b.author, description: b.description },
    }));
  } catch {
    // The API not being up at build time must not fail the build. The reader
    // resolves its own metadata client-side in that case.
    return [];
  }
}

const { slug } = Astro.params;
const { title, author, description } = Astro.props;
---

<Base title={`${title} — Bookworm`} description={description} bare>
  <Reader slug={slug!} title={title} author={author} client:load />
</Base>
