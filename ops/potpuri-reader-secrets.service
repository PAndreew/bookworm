[Unit]
Description=Decrypt Potpuri reader's AI and billing credentials into volatile storage
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
RuntimeDirectory=potpuri-reader-secrets
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
ExecStart=/usr/bin/systemd-creds decrypt --name=openrouter_api_key /opt/potpuri-reader-vault/openrouter_api_key.cred /run/potpuri-reader-secrets/openrouter_api_key
ExecStart=/usr/bin/systemd-creds decrypt --name=stripe_key /opt/potpuri-reader-vault/stripe_key.cred /run/potpuri-reader-secrets/stripe_key
ExecStart=/usr/bin/systemd-creds decrypt --name=stripe_webhook /opt/potpuri-reader-vault/stripe_webhook.cred /run/potpuri-reader-secrets/stripe_webhook
ExecStartPost=/usr/bin/chmod 0444 /run/potpuri-reader-secrets/openrouter_api_key /run/potpuri-reader-secrets/stripe_key /run/potpuri-reader-secrets/stripe_webhook
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
